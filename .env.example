# Copy this file to .env and fill in exactly one provider (or keep both and set AI_BRAIN_PROVIDER)
# Example:
# cp .env.example .env

# Provider choice: claude | openai | heuristic | (leave empty for auto)
AI_BRAIN_PROVIDER=claude

# Claude/Anthropic settings
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
# Optional for compatible gateways:
# CLAUDE_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_VERSION=2023-06-01

# OpenAI settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional for compatible gateways:
# OPENAI_BASE_URL=https://api.openai.com/v1
